# Use wrangler secret put to configure cloud deployment.
# SEC requires a descriptive User-Agent with your own contact information.
SEC_USER_AGENT="MarketAtlas/0.1 contact@example.com"
# Optional licensed quote provider. No API keys are ever shipped to the browser.
TWELVE_DATA_API_KEY=""

# Optional Alpha Vantage daily data (free tier usually 100 bars).
ALPHA_VANTAGE_API_KEY=""
